# IoTCloud / 智治推送 环境变量模板
# ⚠️ 真实凭据勿提交仓库。部署时复制本文件为 iotcloud.env 并填入真实值，
#    由 systemd 注入到后端进程（生产路径 /opt/jsc/backend/iotcloud.env）。

# IoTCloud (172.16.8.11) 凭据
IOT_CLOUD_BASE_URL=http://172.16.8.11:6881/prod-api
IOT_CLOUD_USERNAME=__IOT_CLOUD_USERNAME__
IOT_CLOUD_PASSWORD=__IOT_CLOUD_PASSWORD__

# 智治推送图片公网前缀（外网平台拉取 /api/iot-image 用，可被环境变量覆盖）
SMART_PUSH_PUBLIC_BASE=http://111.10.220.226:81

# 如有其他 SMART_PUSH_* 密钥变量，按相同方式在此追加（占位用 __XXX__）。
